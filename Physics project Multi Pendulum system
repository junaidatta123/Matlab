function multiPendulum(theta0Deg, L, dt, nPeriods)
% MULTIPENDULUM Animate multiple pendulums attached to one pivot.
%
% Example:
%   multiPendulum([5 10 15], [0.5 1.0 2.0], 0.02, 5)

    % Default parameters
    if nargin < 1, theta0Deg = [5 10 15]; end
    if nargin < 2, L = [0.5 1.0 2.0]; end
    if nargin < 3, dt = 0.02; end
    if nargin < 4, nPeriods = 5; end

    % Validate inputs
    validateattributes(theta0Deg, {'numeric'}, ...
        {'vector','real','finite','nonempty','>=',0,'<=',15});
    validateattributes(L, {'numeric'}, ...
        {'vector','real','finite','nonempty','>=',0.1,'<=',2.0});
    validateattributes(dt, {'numeric'}, ...
        {'scalar','real','finite','>=',0.01,'<=',0.05});
    validateattributes(nPeriods, {'numeric'}, ...
        {'scalar','real','finite','integer','>=',0,'<=',200});

    theta0Deg = theta0Deg(:).';
    L = L(:).';

    if numel(theta0Deg) ~= numel(L)
        error('Provide one initial angle for each rod length.');
    end

    % Physical parameters
    g = 9.81;
    theta0 = deg2rad(theta0Deg);
    n = numel(L);

    % Small-angle analytical solution
    omega = sqrt(g ./ L);
    T = 2*pi ./ omega;

    % Simulate up to nPeriods of the fastest pendulum
    tEnd = nPeriods * min(T);
    t = 0:dt:tEnd;

    if isempty(t) || t(end) < tEnd
        t = [t, tEnd];
    end

    % Angular positions: one row per pendulum
    theta = theta0(:) .* cos(omega(:) .* t);

    % All bobs are positioned relative to the SAME pivot (0,0)
    x = L(:) .* sin(theta);
    y = -L(:) .* cos(theta);

    % Figure
    fig = figure('Name','Multi-Pendulum Animation', ...
        'NumberTitle','off','Color','w');

    ax = axes(fig);
    hold(ax,'on');
    grid(ax,'on');
    axis(ax,'equal');

    maxL = max(L);
    margin = 0.25*maxL + 0.1;

    xlim(ax,[-maxL-margin, maxL+margin]);
    ylim(ax,[-maxL-margin, 0.25*maxL]);

    xlabel(ax,'Horizontal position (m)');
    ylabel(ax,'Vertical position (m)');
    title(ax,'Multiple Pendulums - Common Pivot');

    % One shared pivot
    plot(ax,0,0,'k+','MarkerSize',12,'LineWidth',2);

    % Distinct colors
    colors = lines(n);

    % Initialize all rods and bobs at the shared pivot
    rod = gobjects(n,1);
    bob = gobjects(n,1);

    for i = 1:n
        rod(i) = plot(ax,[0 x(i,1)],[0 y(i,1)], ...
            'Color',colors(i,:),'LineWidth',2.5);

        bob(i) = plot(ax,x(i,1),y(i,1),'o', ...
            'MarkerSize',10, ...
            'MarkerFaceColor',colors(i,:), ...
            'MarkerEdgeColor','k');
    end

    % Time and angle display
    info = text(ax,-maxL-margin+0.05,0.20*maxL,'', ...
        'FontSize',10,'VerticalAlignment','top');

    % Animation loop
    for k = 1:numel(t)

        if ~isgraphics(fig)
            break
        end

        for i = 1:n
            % Every rod starts at the same pivot
            rod(i).XData = [0 x(i,k)];
            rod(i).YData = [0 y(i,k)];

            bob(i).XData = x(i,k);
            bob(i).YData = y(i,k);
        end

        angleText = sprintf('%.2f deg  ', ...
            rad2deg(theta(:,k)));

        info.String = sprintf('Time: %.2f s\nAngles: %s', ...
            t(k), angleText);

        drawnow;
        pause(dt);
    end
end
